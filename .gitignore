venv/
__pycache__/
*.pyc

# Секреты — никогда не коммитить
*.env
.env.*
telegram-alert.env

# Дампы БД — большие, могут содержать реальные данные
*.dump

# Приватные ключи/сертификаты — на случай, если когда-нибудь окажутся
# рядом с репозиторием (штатно они лежат в ~/certs/, вне репо)
*.key
*.pem

# Self-hosted GitHub Actions runner — .credentials/.runner внутри содержат
# реальные учётные данные раннера. Никогда не должны попасть в git,
# особенно в публичный репозиторий.
actions-runner*/

# Прочее
.DS_Store
