# Пароль Redis. Сгенерировать: openssl rand -hex 24
REDIS_PASSWORD=
# Администратор MinIO. Пароль: openssl rand -hex 24
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Сервис-аккаунт приложения в MinIO (политика только на бакет uploads, не root).
# Создаётся админом через mc, см. RUNBOOK. Ключ: openssl rand -hex 12, секрет: openssl rand -hex 24
S3_ACCESS_KEY=
S3_SECRET_KEY=
